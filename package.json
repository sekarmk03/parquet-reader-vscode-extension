{
  "name": "parquet-reader",
  "displayName": "Parquet Reader",
  "description": "View .parquet files as a readable table with column summary",
  "version": "0.1.0",
  "publisher": "sekarmk03",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sekarmk03/parquet-reader-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/sekarmk03/parquet-reader-vscode-extension/issues"
  },
  "homepage": "https://github.com/sekarmk03/parquet-reader-vscode-extension#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "parquet",
    "columnar",
    "data",
    "table viewer",
    "s3",
    "spark",
    "pyarrow"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sekarmk03.parquetReader.openUrl",
        "title": "Open Parquet from URL\u2026",
        "category": "Parquet"
      }
    ],
    "customEditors": [
      {
        "viewType": "sekarmk03.parquetReader.table",
        "displayName": "Parquet Table",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.pq"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Parquet Reader",
      "properties": {
        "parquetReader.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 1000,
          "markdownDescription": "Rows shown per page. Lowered automatically on files with many columns, because rendering cost grows with rows x columns rather than with rows alone."
        },
        "parquetReader.sortCellBudget": {
          "type": "number",
          "default": 500000,
          "minimum": 0,
          "markdownDescription": "Largest file that column sorting will load, counted in cells (rows x columns). Sorting holds every row in memory, so the limit is on cells, not rows. Set to `0` to turn sorting off entirely."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "sample": "node test/make-sample.mjs",
    "demo": "node test/make-demo.mjs",
    "icon": "node tools/make-icon.mjs columnar 256 icon.png",
    "smoke": "node esbuild.mjs --smoke && node dist/smoke.js",
    "package": "node esbuild.mjs --production && vsce package"
  },
  "dependencies": {
    "hyparquet": "^1.27.1",
    "hyparquet-compressors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "hyparquet-writer": "^0.16.5",
    "typescript": "^7.0.2"
  }
}
